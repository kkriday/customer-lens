# Answer backend selection: extractive (default), openai, or azure.
# LLM_BACKEND=openai

# OpenAI-compatible chat completions backend (customerlens/llm.py).
# Works with OpenAI, Azure OpenAI, or a local Ollama server: just point
# LLM_BASE_URL at the right endpoint. Leave LLM_API_KEY unset to run fully
# offline with the extractive backend.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=<your-key>
LLM_MODEL=gpt-4o-mini

# Legacy Azure OpenAI backend (customerlens/rag.py). Still supported; the
# llm.py backend above covers Azure too via LLM_BASE_URL.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=<your-key>
AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>
